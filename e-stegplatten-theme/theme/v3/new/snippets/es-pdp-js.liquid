g.setAttribute('viewBox','0 0 440 '+(by+30));g.innerHTML=h;var l=q('[data-plan-l]');if(l)l.textContent=sm(w)+' m × '+sm(d)+' m = '+sm(w*d)+' m²'}
var btn=q('[data-atc]'),spr=q('[data-sticky-price]'),idIn=q('[data-id]');
