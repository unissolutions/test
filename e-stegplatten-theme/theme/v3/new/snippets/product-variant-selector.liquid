    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }
  
  .summary-title { color: var(--akzent-dark); font-size: 13px; text-transform: uppercase; }
  
  .edit-btn {
    font-size: 11px;
    background: transparent;
    border: 1px solid var(--akzent-dark);
    padding: 3px 8px;
    border-radius: 0;
    cursor: pointer;
    text-transform: uppercase;
  }
  
  .summary-content { font-size: 13px; color: #444; }
  
  @media (max-width: 640px) { 
    .z-grid-2col { grid-template-columns: 1fr; }
  } 
</style> 
  
<script> 
(function() { 
  const root = document.getElementById('TerrassenRoot'); 
  if (!root) return;

  const MAX_BREITE_MM = {{ max_breite | default: 0 }};
  const MAX_TIEFE_MM = {{ max_tiefe | default: 0 }};
  const terrassenRequestBtn = document.getElementById('terrassen-anfrage-btn');
  const saveTerrassenBtn = document.getElementById('save-terrassen-btn');

  function toggleTerrassenRequestButton(show) {
    if (terrassenRequestBtn) {
      terrassenRequestBtn.style.display = show ? 'block' : 'none';
    }
    if (saveTerrassenBtn) {
      saveTerrassenBtn.style.display = show ? 'none' : 'block';
    }
  }
  
  function findProductForm() { 
    return root.closest('form[action*="/cart/add"]') || document.querySelector('form[action*="/cart/add"]'); 
  }

  function getErrorElement(input) {
    const wrapper = input.closest('.z-field, .t-field-full');
    return wrapper ? wrapper.querySelector('.z-field-error') : null;
  }

  function showFieldError(input, message) {
    input.classList.add('is-error');
    const errorEl = getErrorElement(input);
    if (errorEl) errorEl.textContent = message;
  }

  function clearFieldError(input) {
    input.classList.remove('is-error');
    const errorEl = getErrorElement(input);
    if (errorEl) errorEl.textContent = '';
  }

  function parseMeterToMm(value) {
    const normalized = String(value || '').replace(',', '.').trim();
    const num = Number(normalized);
    if (!num || num <= 0) return 0;
    return Math.round(num * 1000);
  }

  function validateTerrassenInput(inp) {
    const field = inp.dataset.field;
    const raw = (inp.value || '').trim();

    if (!raw) {
      showFieldError(inp, 'Bitte alle Felder korrekt ausfüllen.');
      return false;
    }

    if (field === 'Durchgangshöhe') {
      const numericHeight = Number(raw);

      if (!numericHeight || numericHeight < 2000 || numericHeight > 2500) {
        showFieldError(inp, 'Die Durchgangshöhe liegt außerhalb des zulässigen Bereichs. Für Sondermaße nutzen Sie bitte die individuelle Anfrage.');
        toggleTerrassenRequestButton(true);
        return false;
      }

      const allInputsHeightCheck = root.querySelectorAll('.z-input');
      const hasExceededHeightCheck = Array.from(allInputsHeightCheck).some(input => {
        const fieldName = input.dataset.field;
        const rawValue = (input.value || '').trim();

        if (!rawValue) return false;

        if (fieldName === 'Durchgangshöhe') {
          const h = Number(rawValue);
          return h < 2000 || h > 2500;
        }

        if (fieldName === 'Breite') {
          const mm = parseMeterToMm(rawValue);
          return MAX_BREITE_MM > 0 && mm > MAX_BREITE_MM;
        }

        if (fieldName === 'Tiefe') {
          const mm = parseMeterToMm(rawValue);
          return MAX_TIEFE_MM > 0 && mm > MAX_TIEFE_MM;
        }

        return false;
      });

      toggleTerrassenRequestButton(hasExceededHeightCheck);
      clearFieldError(inp);
      return true;
    }

    const numericMm = parseMeterToMm(raw);

    if (!numericMm) {
      showFieldError(inp, 'Bitte einen gültigen Wert eingeben.');
      return false;
    }

    if (field === 'Breite' && MAX_BREITE_MM > 0 && numericMm > MAX_BREITE_MM) {
      showFieldError(inp, `Die Breite überschreitet das maximal verfügbare Maß von ${(MAX_BREITE_MM / 1000).toFixed(2)} m. Für Sondermaße nutzen Sie bitte die individuelle Anfrage.`);
      toggleTerrassenRequestButton(true);
      return false;
    }

    if (field === 'Tiefe' && MAX_TIEFE_MM > 0 && numericMm > MAX_TIEFE_MM) {
      showFieldError(inp, `Die Tiefe überschreitet das maximal verfügbare Maß von ${(MAX_TIEFE_MM / 1000).toFixed(2)} m. Für Sondermaße nutzen Sie bitte die individuelle Anfrage.`);
      toggleTerrassenRequestButton(true);
      return false;
    }

    const allInputs = root.querySelectorAll('.z-input');
    const hasExceededValue = Array.from(allInputs).some(input => {
      const fieldName = input.dataset.field;
      const rawValue = (input.value || '').trim();

      if (!rawValue) return false;

      if (fieldName === 'Durchgangshöhe') {
        const h = Number(rawValue);
        return h < 2000 || h > 2500;
      }

      if (fieldName === 'Breite') {
        const mm = parseMeterToMm(rawValue);
        return MAX_BREITE_MM > 0 && mm > MAX_BREITE_MM;
      }

      if (fieldName === 'Tiefe') {
        const mm = parseMeterToMm(rawValue);
        return MAX_TIEFE_MM > 0 && mm > MAX_TIEFE_MM;
      }

      return false;
    });

    toggleTerrassenRequestButton(hasExceededValue);

    clearFieldError(inp);
    return true;
  }

  root.querySelectorAll('.z-input').forEach(inp => {
    inp.addEventListener('input', () => validateTerrassenInput(inp));
    inp.addEventListener('blur', () => validateTerrassenInput(inp));
  });
  
  document.getElementById('open-terrassen-btn').onclick = () => { 
    document.getElementById('terrassen-form').style.display = 'block'; 
    document.getElementById('open-terrassen-btn').style.display = 'none'; 
  }; 
  
  document.getElementById('close-terrassen-btn').onclick = () => { 
    document.getElementById('terrassen-form').style.display = 'none'; 
    document.getElementById('open-terrassen-btn').style.display = 'flex'; 
  }; 
  
  document.getElementById('save-terrassen-btn').onclick = () => { 
    const productForm = findProductForm(); 
    if (!productForm) return; 
  
    const inputs = root.querySelectorAll('.z-input'); 
    let summaryHTML = ''; 
    let hasError = false; 
  
    productForm.querySelectorAll('.generated-terrassen-prop').forEach(p => p.remove()); 
  
    inputs.forEach(inp => { 
      const field = inp.dataset.field; 
      const raw = (inp.value || '').trim(); 
      const valid = validateTerrassenInput(inp);

      if (!valid) {
        hasError = true;
        return;
      }

      const hiddenInp = document.createElement('input'); 
      hiddenInp.type = 'hidden'; 
      hiddenInp.name = `properties[${field}]`; 
      hiddenInp.value = raw; 
      hiddenInp.className = 'generated-terrassen-prop'; 
      productForm.appendChild(hiddenInp); 

      let displayValue = raw;
      if (field === 'Breite' || field === 'Tiefe') {
        displayValue = `${raw} m`;
      } else if (field === 'Durchgangshöhe') {
        displayValue = `${raw} mm`;
      }

      summaryHTML += `<div><strong>${field}:</strong> ${displayValue}</div>`; 
    }); 
  
    if (hasError) { 
      productForm.querySelectorAll('.generated-terrassen-prop').forEach(p => p.remove()); 
      toggleTerrassenRequestButton(true);
      return; 
    }

    toggleTerrassenRequestButton(false);
  
    document.getElementById('terrassen-form').style.display = 'none'; 
    document.getElementById('terrassen-summary').style.display = 'block'; 
    document.getElementById('terrassen-summary-text').innerHTML = summaryHTML; 
  }; 
  
  document.getElementById('edit-terrassen-btn').onclick = () => { 
    document.getElementById('terrassen-summary').style.display = 'none'; 
    document.getElementById('terrassen-form').style.display = 'block'; 
  }; 
})(); 
</script>
{%- endif -%}

