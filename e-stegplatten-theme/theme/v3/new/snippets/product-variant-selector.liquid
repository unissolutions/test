    .z-grid { grid-template-columns: 1fr; }
  } 
</style> 
  
<script> 
(function() { 
  const MAX_BREITE = {{ max_breite | default: 0 }};
  const MAX_LAENGE = {{ max_laenge | default: 0 }};

  const root = document.getElementById('ZuschnitteRoot'); 
  if (!root) return;

  const list = document.getElementById('zuschnitte-list'); 
  let zCount = 1;
  const zuschnittRequestBtn = document.getElementById('zuschnitt-anfrage-btn');
  const saveZuschnittBtn = document.getElementById('save-z-btn');

  function toggleZuschnittRequestButton(show) {
    if (zuschnittRequestBtn) {
      zuschnittRequestBtn.style.display = show ? 'block' : 'none';
    }
    if (saveZuschnittBtn) {
      saveZuschnittBtn.style.display = show ? 'none' : 'block';
    }
  }
  
  function findProductForm() { 
    return root.closest('form[action*="/cart/add"]') || document.querySelector('form[action*="/cart/add"]'); 
  } 
  
  function setProductQuantity(productForm, qty) { 
    let qtyInput = productForm.querySelector('input[name="quantity"]'); 
    if (!qtyInput) { 
      qtyInput = productForm.querySelector('input.generated-qty'); 
      if (!qtyInput) { 
        qtyInput = document.createElement('input'); 
        qtyInput.type = 'hidden'; 
        qtyInput.name = 'quantity'; 
        qtyInput.className = 'generated-qty'; 
        productForm.appendChild(qtyInput); 
      } 
    } 
    qtyInput.value = String(qty); 
    qtyInput.dispatchEvent(new Event('input', { bubbles: true })); 
    qtyInput.dispatchEvent(new Event('change', { bubbles: true })); 
  }
  
  function updateCardTitles() {
    const cards = list.querySelectorAll('.z-card');
    cards.forEach((card, index) => {
      const title = card.querySelector('.z-card-title');
      if (title) {
        title.textContent = `Zuschnitt ${index + 1}`;
      }
    });
  }

  function getErrorElement(input) {
    const wrapper = input.closest('.z-field');
    return wrapper ? wrapper.querySelector('.z-field-error') : null;
  }

  function showFieldError(input, message) {
    input.classList.add('is-error');
    input.style.borderColor = '#e53e3e';
    const errorEl = getErrorElement(input);
    if (errorEl) errorEl.textContent = message;
  }

  function clearFieldError(input) {
    input.classList.remove('is-error');
    input.style.borderColor = '#ccc';
    const errorEl = getErrorElement(input);
    if (errorEl) errorEl.textContent = '';
  }

  function validateInput(inp) {
    const field = inp.dataset.field;
    const raw = (inp.value || '').trim();

    if (!raw || Number(raw) <= 0) {
      showFieldError(inp, 'Bitte alle Felder korrekt ausfüllen.');
      return false;
    }

    const numericValue = Number(raw);

    if (field === 'Breite' && MAX_BREITE > 0 && numericValue > MAX_BREITE) {
      showFieldError(inp, `Die eingegebene Breite überschreitet die maximal verfügbare Variante (${MAX_BREITE} mm). Für Sondermaße nutzen Sie bitte die individuelle Anfrage.`);
      toggleZuschnittRequestButton(true);
      return false;
    }

    if (field === 'Länge' && MAX_LAENGE > 0 && numericValue > MAX_LAENGE) {
      showFieldError(inp, `Die eingegebene Länge überschreitet die maximal verfügbare Variante (${MAX_LAENGE} mm). Für Sondermaße nutzen Sie bitte die individuelle Anfrage.`);
      toggleZuschnittRequestButton(true);
      return false;
    }

    const hasExceededValue = Array.from(root.querySelectorAll('.z-input[data-field="Breite"], .z-input[data-field="Länge"]')).some(input => {
      const value = Number((input.value || '').trim());
      if (!value) return false;
      return (input.dataset.field === 'Breite' && MAX_BREITE > 0 && value > MAX_BREITE) ||
             (input.dataset.field === 'Länge' && MAX_LAENGE > 0 && value > MAX_LAENGE);
    });

    toggleZuschnittRequestButton(hasExceededValue);

    clearFieldError(inp);
    return true;
  }

  function attachLiveValidation(card) {
    const inputs = card.querySelectorAll('.z-input');
    inputs.forEach(inp => {
      inp.addEventListener('input', () => validateInput(inp));
      inp.addEventListener('blur', () => validateInput(inp));
    });
  }
  
  function attachRemoveHandler(card) {
    const removeBtn = card.querySelector('.remove-z-btn');
    if (removeBtn) {
      removeBtn.onclick = () => {
        const cards = list.querySelectorAll('.z-card');
        if (cards.length > 1) {
          card.remove();
          updateCardTitles();
          const remainingExceeded = Array.from(root.querySelectorAll('.z-input[data-field="Breite"], .z-input[data-field="Länge"]')).some(input => {
            const value = Number((input.value || '').trim());
            if (!value) return false;
            return (input.dataset.field === 'Breite' && MAX_BREITE > 0 && value > MAX_BREITE) ||
                   (input.dataset.field === 'Länge' && MAX_LAENGE > 0 && value > MAX_LAENGE);
          });
          toggleZuschnittRequestButton(remainingExceeded);
        } else {
          alert('Mindestens ein Zuschnitt muss vorhanden sein.');
        }
      };
    }
  }
  
  const initialCard = list.querySelector('.z-card');
  if (initialCard) {
    attachRemoveHandler(initialCard);
    attachLiveValidation(initialCard);
  }
  
  document.getElementById('open-zuschnitte-btn').onclick = () => { 
    document.getElementById('zuschnitte-form').style.display = 'block'; 
    document.getElementById('open-zuschnitte-btn').style.display = 'none'; 
  }; 
  
  document.getElementById('close-zuschnitte-btn').onclick = () => { 
    document.getElementById('zuschnitte-form').style.display = 'none'; 
    document.getElementById('open-zuschnitte-btn').style.display = 'flex'; 
  }; 
  
  document.getElementById('add-more-z-btn').onclick = () => { 
    zCount++; 
    const card = document.createElement('div'); 
    card.className = 'z-card'; 
    card.innerHTML = ` 
      <div class="z-card-header">
        <div class="z-card-title">Zuschnitt ${zCount}</div>
        <button type="button" class="remove-z-btn" aria-label="Zuschnitt entfernen">✕</button>
      </div>
      <div class="z-grid"> 
        <div class="z-field">
          <label>Anzahl</label>
          <input type="number" class="z-input" data-field="Anzahl" value="1" min="1">
          <div class="z-field-error"></div>
        </div> 
        <div class="z-field">
          <label>Breite (mm)</label>
          <input type="number" class="z-input" data-field="Breite" placeholder="mm" min="1" ${MAX_BREITE > 0 ? `max="${MAX_BREITE}"` : ''}>
          <div class="z-field-error"></div>
        </div> 
        <div class="z-field">
          <label>Länge (mm)</label>
          <input type="number" class="z-input" data-field="Länge" placeholder="mm" min="1" ${MAX_LAENGE > 0 ? `max="${MAX_LAENGE}"` : ''}>
          <div class="z-field-error"></div>
        </div> 
      </div>`; 
    list.appendChild(card);
    attachRemoveHandler(card);
    attachLiveValidation(card);
  }; 
  
  document.getElementById('save-z-btn').onclick = () => { 
    const productForm = findProductForm(); 
    if (!productForm) return; const zc = document.getElementById('z-confirm-input'), zce = document.getElementById('z-confirm-error'); if (zc && !zc.checked) { if (zce) zce.textContent = 'Bitte bestätigen Sie, dass Sie die Maße geprüft haben.'; zc.focus(); return; } if (zce) zce.textContent = ''; 
  
    const cards = list.querySelectorAll('.z-card'); 
    let summaryHTML = ''; 
    let hasError = false; 
    let totalQty = 0; 
  
    productForm.querySelectorAll('.generated-prop').forEach(p => p.remove()); 
  
    cards.forEach((card, i) => { 
      const inputs = card.querySelectorAll('.z-input'); 
      const idx = i + 1; 
      let rowData = {}; 
  
      inputs.forEach(inp => { 
        const field = inp.dataset.field; 
        const raw = (inp.value || '').trim(); 
        const valid = validateInput(inp);

        if (!valid) {
          hasError = true;
        } else {
          rowData[field] = raw; 
        }
  
        const hiddenInp = document.createElement('input'); 
        hiddenInp.type = 'hidden'; 
        hiddenInp.name = `properties[Zuschnitt ${idx} - ${field}]`; 
        hiddenInp.value = raw; 
        hiddenInp.className = 'generated-prop'; 
        productForm.appendChild(hiddenInp); 
      }); 
  
      totalQty += Number(rowData.Anzahl || 0); 
      summaryHTML += `<div>Zuschnitt ${idx}: ${rowData.Anzahl || ''}x (${rowData.Breite || ''}x${rowData.Länge || ''}mm)</div>`; 
    }); 
  
    if (hasError) { 
      productForm.querySelectorAll('.generated-prop').forEach(p => p.remove()); 
      toggleZuschnittRequestButton(true);
      return; 
    }

    toggleZuschnittRequestButton(false);
    setProductQuantity(productForm, totalQty); (function () { const c = document.createElement('input'); c.type = 'hidden'; c.name = 'properties[Maße bestätigt]'; c.value = 'Ja – vom Kunden geprüft (' + new Date().toLocaleDateString('de-DE') + ')'; c.className = 'generated-prop'; productForm.appendChild(c); })();
  
    document.getElementById('zuschnitte-form').style.display = 'none'; 
    document.getElementById('zuschnitte-summary').style.display = 'block'; 
    document.getElementById('zuschnitte-summary-text').innerHTML = summaryHTML + '<div class="z-confirm-ok">✓ Maße vom Kunden geprüft und bestätigt</div>'; 
  }; 
  
  document.getElementById('edit-z-btn').onclick = () => { const zc2 = document.getElementById('z-confirm-input'); if (zc2) zc2.checked = false; 
    document.getElementById('zuschnitte-summary').style.display = 'none'; 
    document.getElementById('zuschnitte-form').style.display = 'block'; 
  }; 
})(); 
</script>
{%- endif -%}

