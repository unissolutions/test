<script> 
(function() { 
  const root = document.getElementById('DachhautRoot'); 
  if (!root) return;

  // Maximalwerte aus Varianten (aus Liquid)
  const MAX_DACHBREITE = {{ max_dachbreite | default: 0 }};
  const MAX_DACHTIEFE = {{ max_dachtiefe | default: 0 }};

  // Button-Referenzen
  const dachhautRequestBtn = document.getElementById('dachhaut-anfrage-btn');
  const saveDachhautBtn = document.getElementById('save-dachhaut-btn');
  
  function findProductForm() { 
    return root.closest('form[action*="/cart/add"]') || document.querySelector('form[action*="/cart/add"]'); 
  }

  function toggleDachhautRequestButton(show) {
    if (dachhautRequestBtn) {
      dachhautRequestBtn.style.display = show ? 'block' : 'none';
    }
    if (saveDachhautBtn) {
      saveDachhautBtn.style.display = show ? 'none' : 'block';
    }
  }

  function showFieldError(input, message) {
    input.classList.add('is-error');
    const errorEl = input.parentElement.querySelector('.dachhaut-field-error');
    if (errorEl) errorEl.textContent = message;
  }

  function clearFieldError(input) {
    input.classList.remove('is-error');
    const errorEl = input.parentElement.querySelector('.dachhaut-field-error');
    if (errorEl) errorEl.textContent = '';
  }

  function checkAnyExceeded() {
    const dachbreiteVal = Number(document.getElementById('dachhaut-dachbreite').value || 0);
    const dachtiefeVal = Number(document.getElementById('dachhaut-dachtiefe').value || 0);
    
    const breiteExceeded = MAX_DACHBREITE > 0 && dachbreiteVal > MAX_DACHBREITE;
    const tiefeExceeded = MAX_DACHTIEFE > 0 && dachtiefeVal > MAX_DACHTIEFE;
    
    return breiteExceeded || tiefeExceeded;
  }

  function validateDachhautInput(inp) {
    const fieldId = inp.id;
    const raw = (inp.value || '').trim();

    // Prüfe ob Feld leer oder ungültig
    if (!raw || Number(raw) <= 0) {
      showFieldError(inp, fieldId === 'dachhaut-dachbreite' 
        ? 'Bitte eine gültige Dachbreite eingeben.' 
        : 'Bitte eine gültige Dachtiefe eingeben.');
      return false;
    }

    const numericValue = Number(raw);

    // Prüfe Dachbreite gegen Maximum
    if (fieldId === 'dachhaut-dachbreite' && MAX_DACHBREITE > 0 && numericValue > MAX_DACHBREITE) {
      showFieldError(inp, `Die eingegebene Dachbreite überschreitet die maximal verfügbare Variante (${MAX_DACHBREITE} mm). Für Sondermaße nutzen Sie bitte die individuelle Anfrage.`);
      toggleDachhautRequestButton(true);
      return false;
    }

    // Prüfe Dachtiefe gegen Maximum
    if (fieldId === 'dachhaut-dachtiefe' && MAX_DACHTIEFE > 0 && numericValue > MAX_DACHTIEFE) {
      showFieldError(inp, `Die eingegebene Dachtiefe überschreitet die maximal verfügbare Variante (${MAX_DACHTIEFE} mm). Für Sondermaße nutzen Sie bitte die individuelle Anfrage.`);
      toggleDachhautRequestButton(true);
      return false;
    }

    // Feld ist OK - lösche Fehler
    clearFieldError(inp);

    // Prüfe ob irgendein anderes Feld noch überschritten ist
    toggleDachhautRequestButton(checkAnyExceeded());

    return true;
  }

  function validateAllDachhautInputs() {
    const dachbreite = document.getElementById('dachhaut-dachbreite');
    const dachtiefe = document.getElementById('dachhaut-dachtiefe');
    let hasError = false;

    if (!validateDachhautInput(dachbreite)) {
      hasError = true;
    }

    if (!validateDachhautInput(dachtiefe)) {
      hasError = true;
    }

    return !hasError;
  }

  // Live-Validierung
  const dachbreiteInput = document.getElementById('dachhaut-dachbreite');
  const dachtiefeInput = document.getElementById('dachhaut-dachtiefe');

  if (dachbreiteInput) {
    dachbreiteInput.addEventListener('input', () => validateDachhautInput(dachbreiteInput));
    dachbreiteInput.addEventListener('blur', () => validateDachhautInput(dachbreiteInput));
  }

  if (dachtiefeInput) {
    dachtiefeInput.addEventListener('input', () => validateDachhautInput(dachtiefeInput));
    dachtiefeInput.addEventListener('blur', () => validateDachhautInput(dachtiefeInput));
  }
  
  document.getElementById('open-dachhaut-btn').onclick = () => { 
    document.getElementById('dachhaut-form').style.display = 'block'; 
    document.getElementById('open-dachhaut-btn').style.display = 'none'; 
  }; 
  
  document.getElementById('close-dachhaut-btn').onclick = () => { 
    document.getElementById('dachhaut-form').style.display = 'none'; 
    document.getElementById('open-dachhaut-btn').style.display = 'flex'; 
  }; 
  
  document.getElementById('save-dachhaut-btn').onclick = () => { 
    const productForm = findProductForm(); 
    if (!productForm) return; 

    if (!validateAllDachhautInputs()) {
      return;
    }

    // Falls noch Überschreitungen vorhanden sind, nicht speichern
    if (checkAnyExceeded()) {
      toggleDachhautRequestButton(true);
      return;
    }
  
    // Entferne alte Properties
    productForm.querySelectorAll('.generated-dachhaut-prop').forEach(p => p.remove()); 

    // Hole Werte
    const schraubentyp = root.querySelector('input[name="dachhaut_schraubentyp"]:checked').value;
    const dachbreite = document.getElementById('dachhaut-dachbreite').value;
    const dachtiefe = document.getElementById('dachhaut-dachtiefe').value;
    const symmetrie = root.querySelector('input[name="dachhaut_symmetrie"]:checked').value;

    // Erstelle hidden inputs für Cart Properties
    const props = [
      { name: 'properties[Schraubentyp]', value: schraubentyp },
      { name: 'properties[Dachbreite]', value: dachbreite + ' mm' },
      { name: 'properties[Dachtiefe]', value: dachtiefe + ' mm' },
      { name: 'properties[Symmetrie]', value: symmetrie }
    ];

    props.forEach(prop => {
      const hiddenInp = document.createElement('input'); 
      hiddenInp.type = 'hidden'; 
      hiddenInp.name = prop.name; 
      hiddenInp.value = prop.value; 
      hiddenInp.className = 'generated-dachhaut-prop'; 
      productForm.appendChild(hiddenInp);
    });

    // Summary erstellen
    let summaryHTML = `
      <div><strong>Schraubentyp:</strong> ${schraubentyp}</div>
      <div><strong>Dachbreite:</strong> ${dachbreite} mm</div>
      <div><strong>Dachtiefe:</strong> ${dachtiefe} mm</div>
      <div><strong>Symmetrie:</strong> ${symmetrie}</div>
    `;

    toggleDachhautRequestButton(false);
  
    document.getElementById('dachhaut-form').style.display = 'none'; 
    document.getElementById('dachhaut-summary').style.display = 'block'; 
    document.getElementById('dachhaut-summary-text').innerHTML = summaryHTML; 
  }; 
  
  document.getElementById('edit-dachhaut-btn').onclick = () => { 
    document.getElementById('dachhaut-summary').style.display = 'none'; 
    document.getElementById('dachhaut-form').style.display = 'block'; 
  }; 
})(); 
</script>
{%- endif -%}

