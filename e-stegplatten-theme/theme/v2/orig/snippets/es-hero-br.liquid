<script>document.addEventListener('DOMContentLoaded',function(){document.documentElement.lang=document.documentElement.lang||'de';var h=document.querySelector('.esl .hero h1');if(h&&!h.querySelector('br'))h.innerHTML=h.innerHTML.replace(/\.\s+(Geliefert)/,'.<br>$1');
var M=[[/^Liefer/i,'5–8 Tage Lieferzeit'],[/^Zuschnitt/i,'Zuschnitt nach Maß'],[/Bezahl|Zahlung/i,'Zahlen bei Lieferung'],[/^Beratung/i,'Beratung Mo–Fr']];
document.querySelectorAll('.esl .trust .c>div>span').forEach(function(s){if(!s.querySelector('span'))s.innerHTML=s.innerHTML.replace(/<\/b>\s*·\s*/,'</b><span>').replace(/$/,'</span>');var b=s.querySelector('b');if(!b)return;var t=b.textContent.trim();for(var i=0;i<M.length;i++)if(M[i][0].test(t)){b.textContent=M[i][1];break}});
document.querySelectorAll('.esl .cats .cat').forEach(function(c){var t=c.querySelector('h3');if(t&&!t.dataset.es){t.dataset.es=1;t.innerHTML=t.innerHTML.replace('Terrassenüberdachung','Terrassen&shy;überdachung').replace('Stegplatten','Steg&shy;platten')}
var img=c.querySelector('img');if(!img)return;var box=img;while(box.parentElement&&box.parentElement!==c)box=box.parentElement;if(box===img||box.classList.contains('tx')){var w=document.createElement('div');img.parentNode.insertBefore(w,img);w.appendChild(img);box=w}box.classList.add('es-cimg')})});</script>