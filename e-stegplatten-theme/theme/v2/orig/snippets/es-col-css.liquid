.es-col .es-card__pr s{display:inline;font-size:11px}
.es-col .es-card__save{font-size:10.5px}
.es-col .es-card__btn{height:38px;font-size:13px}
.es-col .es-badge{height:22px;font-size:11px;padding:0 8px}
