{%- comment -%}e-Stegplatten: „Klar, opal oder getönt?“ – Eindeckungs-Auswahl. Setzt sich (Option) direkt hinter die Kategorien der Startseite. Enthält außerdem den Mobile-Feinschliff der Startseite (.esl).{%- endcomment -%}
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,400..800&display=swap">
<style>
.esk{background:#EFF3F0;padding:60px 0;font-family:Archivo,system-ui,sans-serif;color:#4A544F;border-top:1px solid #E1E5E2;border-bottom:1px solid #E1E5E2}
.esk .esk__c{max-width:1280px;margin:0 auto;padding:0 24px}
.esk .esk__h{font-family:Archivo,sans-serif;font-stretch:125%;font-weight:800;font-size:clamp(26px,3vw,40px);line-height:1.1;letter-spacing:-.01em;color:#1B1F1D;margin:0 0 12px}
.esk .esk__lead{font-size:18px;line-height:1.6;margin:0 0 30px;max-width:54ch;color:#4A544F}
.esk .esk__g{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}
.esk .esk__card{display:flex;flex-direction:column;color:inherit!important;text-decoration:none!important}
.esk .esk__v{position:relative;height:176px;border:1px solid #DCE3DE;border-radius:12px!important;overflow:hidden;transition:border-color .15s}
.esk .esk__v::before{content:"";position:absolute;inset:0;z-index:2;background:repeating-linear-gradient(90deg,transparent 0 29px,rgba(255,255,255,.8) 29px 31px,rgba(0,0,0,.05) 31px 32px)}
.esk .esk__v--klar{background:linear-gradient(100deg,#F7FAEF 0%,#E2EEF5 35%,#C8DEEE 70%,#A7C7DF 100%)}
.esk .esk__v--opal{background:linear-gradient(100deg,#FFFFFF 0%,#F4F5F4 60%,#E3E5E3 100%)}
.esk .esk__v--graphit{background:linear-gradient(100deg,#72787F 0%,#555B61 55%,#33383C 100%)}
.esk .esk__v--graphit::before{background:repeating-linear-gradient(90deg,transparent 0 29px,rgba(255,255,255,.2) 29px 31px,rgba(0,0,0,.2) 31px 32px)}
.esk .esk__sun{position:absolute;right:30px;top:28px;z-index:1;width:58px;height:58px;border-radius:50%!important;background:#FFF5C4;box-shadow:0 0 32px 16px rgba(255,236,150,.6)}
.esk .esk__v--opal .esk__sun{background:#fff;box-shadow:0 0 44px 28px rgba(255,255,255,.95);filter:blur(6px)}
.esk .esk__v--graphit .esk__sun{background:#A8A48C;box-shadow:0 0 22px 6px rgba(168,164,140,.3)}
.esk .esk__card h3{font-family:Archivo,sans-serif;font-stretch:115%;font-weight:700;font-size:21px;line-height:1.2;color:#1B1F1D;margin:18px 0 8px}
.esk .esk__card p{margin:0 0 14px;font-size:16px;line-height:1.55;flex:1;color:#4A544F}
.esk .esk__ft{display:flex;justify-content:space-between;align-items:baseline;gap:12px}
.esk .esk__ft b{font-size:17px;color:#1B1F1D;font-weight:700}
.esk .esk__ft span{font-weight:700;color:#2A6C49;border-bottom:2px solid #2A6C49;padding-bottom:1px}
.esk .esk__card:hover .esk__v{border-color:#9DAAA2}.esk .esk__card:hover .esk__ft span{color:#338258;border-color:#338258}
@media(max-width:749px){.esk{padding:36px 0}.esk .esk__c{padding:0 16px}.esk .esk__lead{font-size:16px;margin-bottom:20px}.esk .esk__g{grid-template-columns:1fr;gap:24px}.esk .esk__v{height:118px}.esk .esk__sun{width:46px;height:46px;top:20px;right:22px}.esk .esk__card h3{margin-top:12px;font-size:19px}.esk .esk__card p{font-size:15px;margin-bottom:10px}}
/* Startseite: Mobile-Feinschliff */
@media(max-width:749px){
body .esl{font-size:15px}
body .esl .s{padding:32px 0}
body .esl .hero img{aspect-ratio:16/10}
body .esl .proof{grid-template-columns:repeat(3,1fr)}
body .esl .proof div{border-right:1px solid var(--ln);border-bottom:none;padding:10px 8px;font-size:11px;line-height:1.35}
body .esl .proof div:last-child{border-right:none}
body .esl .proof b{font-size:13px;line-height:1.25}
body .esl .fin__opt{font-size:14px}
body .esl .trust .c{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:8px;padding:10px 16px;scrollbar-width:none}
body .esl .trust .c::-webkit-scrollbar{display:none}
body .esl .trust div{flex:none;scroll-snap-align:start;border:1px solid var(--ln)!important;background:#fff;padding:8px 12px;font-size:13px;white-space:nowrap}
body .esl .head .btn.o{display:inline-flex;height:40px;padding:0 14px;font-size:14px}
body .esl .prods{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:12px;margin:0 -16px;padding:0 16px 6px;scrollbar-width:none}
body .esl .prods::-webkit-scrollbar{display:none}
body .esl .pc{flex:0 0 76%;scroll-snap-align:start}
body .esl .pc__t{font-size:15px}
body .esl .pc__pr b{font-size:19px}
body .esl .pc__btn{height:48px;font-size:15px}
body .esl .steps{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;border:none;gap:10px;margin:0 -16px;padding:0 16px 6px;scrollbar-width:none}
body .esl .steps::-webkit-scrollbar{display:none}
body .esl .step{flex:0 0 80%;scroll-snap-align:start;border:1px solid var(--ln)!important}
body .esl summary{min-height:52px;align-items:center;font-size:15px}
body .esl .help .btn{height:52px}
}
</style>
<div class="esk" id="esk-{{ section.id }}" data-screen-label="Eindeckung"><div class="esk__c">
<h2 class="esk__h">{{ section.settings.title }}</h2>
{%- if section.settings.text != blank -%}<p class="esk__lead">{{ section.settings.text }}</p>{%- endif -%}
<div class="esk__g">
{%- for b in section.blocks -%}{%- assign bp = b.settings.product -%}
<a class="esk__card" href="{% if bp != blank %}{{ bp.url }}{% elsif b.settings.url != blank %}{{ b.settings.url }}{% else %}/collections/terrassenuberdachung{% endif %}" {{ b.shopify_attributes }}><div class="esk__v esk__v--{{ b.settings.look }}"><span class="esk__sun"></span></div><h3>{{ b.settings.title }}</h3><p>{{ b.settings.text }}</p><div class="esk__ft"><b>{%- if bp != blank -%}ab {{ bp.price_min | money_without_currency }} €{%- endif -%}</b><span>{{ b.settings.cta | default: 'Ansehen' }}</span></div></a>
{%- endfor -%}
</div>
</div></div>
{%- if section.settings.after_cats -%}<script>(function(){var me=document.getElementById('esk-{{ section.id }}'),w=me&&me.closest('.shopify-section'),t=document.querySelector('.esl [data-screen-label="Kategorien"]');if(w&&t)t.parentNode.insertBefore(w,t.nextSibling)})();</script>{%- endif -%}
{% schema %}
{"name":"ES Eindeckung wählen","tag":"section","settings":[
{"type":"text","id":"title","label":"Überschrift","default":"Klar, opal oder getönt?"},
{"type":"textarea","id":"text","label":"Text","default":"Die Eindeckung entscheidet, wie hell es unter dem Dach wird. Alle drei gibt es für Rahmen in Anthrazit und Weiß."},
{"type":"checkbox","id":"after_cats","label":"Auf der Startseite direkt hinter „Kategorien“ anzeigen","default":true}
],"blocks":[{"type":"option","name":"Eindeckung","limit":4,"settings":[
{"type":"select","id":"look","label":"Darstellung","options":[{"value":"klar","label":"Klar"},{"value":"opal","label":"Opal"},{"value":"graphit","label":"Graphit"}],"default":"klar"},
{"type":"text","id":"title","label":"Titel","default":"Klar"},
{"type":"textarea","id":"text","label":"Text"},
{"type":"product","id":"product","label":"Produkt (Preis „ab“ + Link)"},
{"type":"url","id":"url","label":"Link ohne Produkt"},
{"type":"text","id":"cta","label":"Link-Text","default":"Ansehen"}
]}],"presets":[{"name":"ES Eindeckung wählen"}]}
{% endschema %}