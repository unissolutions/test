<script>(function(){var MAP={'Wähle Deine Optionen':'Größe wählen','Wähle deine Optionen':'Größe wählen'};function fx(root){(root||document).querySelectorAll('.product-item__action-button').forEach(function(b){var t=b.textContent.trim();if(MAP[t])b.textContent=MAP[t]})}document.addEventListener('DOMContentLoaded',function(){fx();var to;new MutationObserver(function(){clearTimeout(to);to=setTimeout(fx,120)}).observe(document.body,{childList:true,subtree:true})})})();</script>
