html body .card:not(#_),html body .card__section:not(#_),html body .product-block:not(#_),html body .product-block-list__item:not(#_),html body .product-gallery:not(#_),html body .product-meta:not(#_),html body .product-form__payment-container:not(#_),html body .product-item:not(#_),html body .es-card:not(#_){box-shadow:none!important}
