html body .jdgm-carousel-item__product-title:not(#_){font-size:13px!important;font-weight:600!important;color:#1B1F1D!important;text-align:left!important}
html body .jdgm-carousel__arrows:not(#_){justify-content:flex-start!important;margin:14px 0 0!important}
